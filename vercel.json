{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/bilebandi-heidi-",
      "destination": "/bilebandi-heidi-and-the-hot-stuff",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(admin|login)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "crons": [
    {
      "path": "/api/keep-db-alive",
      "schedule": "0 12 */5 * *"
    }
  ]
}
