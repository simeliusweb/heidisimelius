# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Production does NOT read this file. Vercel supplies these from the project's
# Environment Variables (Settings -> Environment Variables). If you add or rename a
# VITE_* var here, add it there too — Vite inlines VITE_* at BUILD time, so a missing
# one ships a broken bundle rather than failing at runtime.

# Supabase client (inlined into the browser bundle; RLS is what protects the data)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side, runtime only — set these in the Vercel project env for production.
BREVO_API_KEY=""
SUPABASE_FUNCTION_URL=""

# CMS login, used for local admin testing. Put real values in .env.local.
CMS_ACCOUNT=""
CMS_ACCOUNT_PASSWORD=""
